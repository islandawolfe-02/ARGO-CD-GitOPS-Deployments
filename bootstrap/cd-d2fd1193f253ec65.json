eployment-id\": \"cd-d2fd1193f253ec65\"}}}, {\"apiVersion\": \"v1\", \"kind\": \"Service\", \"metadata\": {\"name\": \"loki\", \"namespace\": \"demo-app\", \"labels\": {\"gitops/deployment-id\": \"cd-d2fd1193f253ec65\"}}}, {\"apiVersion\": \"v1\", \"kind\": \"ConfigMap\", \"metadata\": {\"name\": \"grafana-provisioning\", \"namespace\": \"demo-app\", \"labels\": {\"gitops/deployment-id\": \"cd-d2fd1193f253ec65\"}}}, {\"apiVersion\": \"apps/v1\", \"kind\": \"Deployment\", \"metadata\": {\"name\": \"grafana\", \"namespace\": \"demo-app\", \"labels\": {\"gitops/deployment-id\": \"cd-d2fd1193f253ec65\"}}}, {\"apiVersion\": \"v1\", \"kind\": \"Service\", \"metadata\": {\"name\": \"grafana\", \"namespace\": \"demo-app\", \"labels\": {\"gitops/deployment-id\": \"cd-d2fd1193f253ec65\"}}}]"
